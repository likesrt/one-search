# One Search Relay 环境变量
#
#   cp .env.example .env    # 填必填项即可启动；其余按需取消注释
#
# 写法：必填项保持开启；有出厂默认值的项一律注释掉，注释里就是默认值，
# 需要自定义时去掉行首的 #。未出现在本文件的变量，容器入口脚本会填入
# 与注释完全相同的默认值，所以「注释掉」与「不写」等价。

# ──────────────────────────────────────────────────────────────
# 必填（留空或缺失会启动失败，入口脚本会直接报错退出）
# ──────────────────────────────────────────────────────────────

# 数据库密码。同时用于容器内 PostgreSQL 与后端连接。
POSTGRES_PASSWORD=

# 管理员密码，首次启动时创建该账号；之后改这里不会覆盖已有密码。
ADMIN_PASSWORD=

# 加密密钥：上游 API Key 与凭据明文的加解密都用它。
# 至少 32 字符，生成：openssl rand -base64 32
# 丢失后已加密的数据无法恢复，请与数据库一起备份。
ENCRYPTION_KEY=

# 宿主机端口，容器内固定 80。compose 的端口映射要读它，因此必须保留（可改值）。
HOST_PORT=5173

# 是否开启 MCP 端点。入口脚本兜底为关闭，这里显式开启是本项目的出厂状态。
MCP_ENABLED=true

# ──────────────────────────────────────────────────────────────
# 可选（都有默认值，需要时取消注释）
# ──────────────────────────────────────────────────────────────

# 管理员用户名，仅首次启动创建时使用。
#ADMIN_USERNAME=admin

# 是否要求 /v1/* 与 MCP 请求携带 API Token。关掉后任何人都能调用搜索接口，
# 仅建议本地调试时关闭。
#API_AUTH_REQUIRED=true

# MCP 端点路径，同时会额外挂载 /v1/mcp 兼容路径。
#MCP_PATH=/mcp

# CORS 白名单，逗号分隔。仅当前端与后端不同源时才需要配置
# （一体化部署下前端与后端同源，保持默认即可）。
#CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# 运行环境。production 下会强制校验 ENCRYPTION_KEY 强度；
# 改成 development 会放宽校验并使用开发用默认凭据，请勿在公网使用。
#APP_ENV=production

# 是否在启动时自动执行数据库迁移。
#RUN_MIGRATIONS=true

# 数据库名与用户名（仅在首次初始化数据库时生效，改动不会重命名已有库）。
#POSTGRES_DB=one_search
#POSTGRES_USER=one_search

# 单次搜索的总超时（毫秒）。
#REQUEST_TIMEOUT_MS=20000

# HTTP 请求体上限（字节）。只能写纯数字，不支持表达式。
# 需与反向代理的 client_max_body_size 对齐。
#REQUEST_BODY_LIMIT_BYTES=1048576

# HTTP 服务器各项超时（毫秒）。WRITE 需大于 REQUEST_TIMEOUT_MS，
# 否则上游还没返回连接就被服务器关掉。
#SERVER_READ_HEADER_TIMEOUT_MS=10000
#SERVER_READ_TIMEOUT_MS=30000
#SERVER_WRITE_TIMEOUT_MS=65000
#SERVER_IDLE_TIMEOUT_MS=60000

# 管理员登录会话有效期（小时）。
#ADMIN_SESSION_TTL_HOURS=24

# 登录失败限速：窗口内失败达到次数后锁定。
#ADMIN_LOGIN_MAX_ATTEMPTS=5
#ADMIN_LOGIN_WINDOW_MS=300000
#ADMIN_LOGIN_LOCKOUT_MS=900000

# 上游请求使用的 User-Agent。
#UPSTREAM_USER_AGENT=OneSearchRelay/0.1

# 网页抓取缓存目录（容器内路径）。默认随容器生命周期，
# 需要跨容器重建保留时改为挂载出来的目录。
#FETCH_CACHE_DIR=/app/data/fetch-cache
